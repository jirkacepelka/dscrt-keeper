# Keeper configuration.
#
# This key needs gas and nothing else. Every task the keeper performs is a permissionless
# message anyone could send, so a leaked keeper key costs the operator SCRT and stalls
# upkeep until a replacement runs — it cannot move user funds or change any parameter.
# Never put the manager's key here.
#
# Losing the keeper costs yield, not access: deposits, withdrawals and claims all keep
# their own bookkeeping, so nobody is locked out of their money while it is down.

# The only line you have to fill in. Everything below already points at the live dSCRT
# deployment, so `cp .env.example .env`, paste a mnemonic, and the keeper runs.
KEEPER_MNEMONIC="twelve or twenty four words"

# Defaults, repeated here so they are visible rather than buried in the source.
# CHAIN_ID=pulsar-3
# LCD_URL=https://pulsar.lcd.secretnodes.com
# LST_CORE_ADDRESS=secret1lj23n74aan7nlgj6hfm45fh3gc7h2ctdplsw8y

# Pin the contract's code hash.
#
# Leave it unset and the keeper asks the chain, which is what lets it sit through a
# migration without anyone editing this file. Set it and the keeper uses yours and never
# looks — a deliberate refusal to follow the contract admin anywhere, at the cost of
# stopping dead the moment they migrate.
# LST_CORE_CODE_HASH=

# How often to harvest, restake, and — as a side effect of doing those — refresh the
# cached totals. This is the only job on a clock, and the only one that spends gas on a
# schedule rather than on an event.
COMPOUND_INTERVAL=1h

# The longest the keeper will go without asking whether a withdrawal window can close or a
# matured one can be collected. Not a cadence: the contract publishes the second each falls
# due, so the keeper wakes for that moment and this only bounds the idle case. Checking
# costs one query and no gas, because nothing is sent unless the contract says it is due.
WINDOW_INTERVAL=15m

# Leave these unset unless you have a reason.
#
# The gas limit is sized per transaction from the validator set — measured, not guessed —
# and setting GAS_LIMIT overrides that with a flat number. The price is twice the chain's
# own minimum, which absorbs a change in that minimum without an emergency redeploy.
#
# PAGE_LIMIT=25
# GAS_LIMIT=
# GAS_PRICE=0.025uscrt
